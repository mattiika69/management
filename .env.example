# Required public configuration. Values prefixed with NEXT_PUBLIC_ are bundled
# into browser code; never put server secrets in NEXT_PUBLIC_ variables.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://sszrrmvuahpwceegymry.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-supabase-anon-or-publishable-key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=replace-with-stripe-publishable-key

# Supported compatibility aliases. Keep them in sync only if older tooling still
# depends on them.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-supabase-publishable-key

# Required server-only billing configuration.
STRIPE_SECRET_KEY=replace-with-stripe-secret-key
STRIPE_WEBHOOK_SECRET=replace-with-stripe-webhook-secret
STRIPE_PRICE_BASIC=price_replace-with-basic-subscription-price-id
STRIPE_PRICE_PRO=price_replace-with-pro-subscription-price-id
STRIPE_PRICE_BUSINESS=price_replace-with-business-subscription-price-id

# Supported Stripe compatibility aliases for the current basic plan.
STRIPE_PRICE_ID=price_replace-with-basic-subscription-price-id
STRIPE_ONBOARDING_PRICE_ID=price_replace-with-basic-subscription-price-id

# Optional one-time credit pack prices.
STRIPE_CREDIT_PACK_STARTER_PRICE_ID=price_your-100-credit-pack-id
STRIPE_CREDIT_PACK_GROWTH_PRICE_ID=price_your-500-credit-pack-id

# Required server-only Supabase admin configuration.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

SLACK_APP_ID=your-slack-app-id
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret
SLACK_SIGNING_SECRET=your-slack-signing-secret
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_BOT_SCOPES=app_mentions:read,chat:write,commands,groups:read,groups:history,incoming-webhook
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_BOT_USERNAME=your_bot_username
TELEGRAM_WEBHOOK_SECRET=your-telegram-webhook-secret
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
MICROSOFT_CLIENT_ID=your-microsoft-oauth-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-oauth-client-secret
MICROSOFT_TENANT_ID=common
ZOOM_CLIENT_ID=your-zoom-oauth-client-id
ZOOM_CLIENT_SECRET=your-zoom-oauth-client-secret
NYLAS_CLIENT_ID=your-nylas-client-id
NYLAS_API_KEY=nyk_v0_your-nylas-api-key
NYLAS_API_REGION=us
NYLAS_CALENDAR_ID=primary
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
AI_MODEL=claude-sonnet-4-5
VERCEL_OIDC_TOKEN=
ANTHROPIC_MODEL=claude-sonnet-4-5
CLAUDE_MODEL=claude-sonnet-4-5
ANTHROPIC_MAX_TOKENS=4000
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Temporary local/preview-only bypass. Production code always ignores bypass.
REQUIRE_LOGIN_AUTH=true
AUTH_BYPASS_ENABLED=false
DISABLE_LOGIN_AUTH=false
AUTH_BYPASS_EMAIL=owner@example.com
AUTH_BYPASS_TENANT_ID=
AUTH_BYPASS_USER_ID=
AUTH_BYPASS_NAME="Local Bypass User"
ADMIN_EMAILS=matt@1000xleads.com

# Required server-only email configuration. EMAIL_FROM must be a verified Resend
# sender/domain, for example "HyperOptimal Management <team@example.com>".
RESEND_API_KEY=replace-with-resend-api-key
EMAIL_FROM="HyperOptimal Management <team@your-domain.com>"

# Supported Resend compatibility aliases.
RESEND_FROM_EMAIL="team@your-domain.com"
RESEND_FROM_NAME="HyperOptimal Management"

ROEZAN_API_KEY=your-roezan-api-key
ROEZAN_API_BASE_URL=https://api.roezan.com
INTEGRATION_SECRET_KEY=your-32-byte-integration-secret
SCHEDULE_WORKER_SECRET=your-schedule-worker-secret
